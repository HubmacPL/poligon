# Editor settings shared by every editor that reads them (https://editorconfig.org).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.ps1]
end_of_line = crlf

[*.{md,txt}]
end_of_line = lf

[*.md]
# Markdown uses two trailing spaces for a line break; none of ours do, but do not strip them.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

# Turns a binary file into a C++ header with a byte array.
# Usage: cmake -DINPUT=<file> -DOUTPUT=<header> -DSYMBOL=<array name> -P EmbedBinary.cmake
foreach(required INPUT OUTPUT SYMBOL)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} is not set")
  endif()
endforeach()

file(READ "${INPUT}" hex_content HEX)
string(LENGTH "${hex_content}" hex_length)
if(hex_length EQUAL 0)
  message(FATAL_ERROR "${INPUT} is empty")
endif()
math(EXPR byte_count "${hex_length} / 2")

# 16 bytes (32 hex digits) per line.
set(lines "")
set(offset 0)
while(offset LESS hex_length)
  string(SUBSTRING "${hex_content}" ${offset} 32 chunk)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
  string(APPEND lines "    ${chunk}\n")
  math(EXPR offset "${offset} + 32")
endwhile()

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedBinary.cmake. Do not edit.
#pragma once

inline constexpr unsigned char ${SYMBOL}[${byte_count}] = {
${lines}};
")

# --- Water and shore plants, made by the engine (poligon/procedural_plants.h), at every lake
# within 1500 m: reeds in shallow water and along the shore, cattails in shallow water,
# water lilies floating where it is deeper. ---
plant procedural/reed
group shore
spacing 1.6
density 0.32
scale 0.8 1.15
water_depth 0 0.5 0.15
water_distance 0 2.5 1.5
patch 30 0.6
area 1500

plant procedural/cattail
group shore
density 0.18
scale 0.85 1.15
water_depth 0.08 0.4 0.08
patch 18 0.45
area 1500

plant procedural/water_lily
spacing 2.2
density 0.14
scale 0.8 1.3
water_depth 0.7 2.5 0.3
on_water 1
patch 28 0.4
area 1500

# --- Ground cover: grows on the fly around the player. Grass made by the engine (real
# blades) covers most of the ground, meadow grass and flowers grow in open, moister patches,
# and the downloaded grass tufts add variety. ---
cover procedural/short_grass
density 8
scale 0.8 1.3
slope 0 35 3
moisture 0.08 1 0.08
water_depth 0 0 0.01
patch 25 0.7
align 1

cover procedural/meadow_grass
density 1.2
scale 0.8 1.3
slope 0 25 3
moisture 0.22 1 0.1
water_distance 1 1e9 1
water_depth 0 0 0.01
patch 40 0.45
align 1

cover procedural/flowers
density 0.08
scale 0.8 1.2
slope 0 20 3
moisture 0.15 0.8 0.1
water_depth 0 0 0.01
patch 30 0.35

# Downloaded grass clumps (Poly Haven): green clumps on most open ground, pale dry ones
# on drier ground.
cover plants/grass_medium
density 2
scale 1 1.6
slope 0 35 3
moisture 0.1 1 0.08
water_depth 0 0 0.01
patch 25 0.6
align 1
every_nth 2

cover plants/grass_tall
density 0.6
scale 1 1.5
slope 0 25 3
moisture 0.03 0.4 0.08
water_depth 0 0 0.01
patch 35 0.45
align 1

cover plants/grass
density 1.5
scale 2.5 4
slope 0 40 3
water_depth 0 0 0.01
patch 20 0.8
align 1
every_nth 3

cover plants/fern

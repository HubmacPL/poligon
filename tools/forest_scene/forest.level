water_depth 0 0 0.01
area 250

plant rocks/boulder
spacing 12
density 0.0006
scale 0.6 2.2
sink 0.25
slope 4 45 4
water_depth 0 0 0.01
area 250

plant wood/stump
spacing 10
density 0.0005

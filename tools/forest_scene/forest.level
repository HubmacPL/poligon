poligon-level 1

# The level of forest_scene (format: docs/en/assets.md, plant rules: docs/en/vegetation.md).
# The land is the terrain generator's default; the lines below only name the settings that
# matter most.
terrain.seed 1
terrain.size 6000
terrain.relief 110
terrain.basin_count 3

# On a slope above the largest lake, looking at it.
player_start lake

# The land is streamed (docs/en/streaming.md): cooked into 512 m patches on the first run,
# with the whole land every 64 m for the far background.
world worlds/forest
world.patch_size 512
world.background_spacing 64

# --- Ground layers, chosen by the generator's maps (format: docs/en/assets.md). Rock
# covers steep ground, so the terrain's steep color is not used. ---
# Mossy forest floor, wherever nothing else fits.
ground ground/forest_floor
tile 3
strength 0.35

# Dry litter in patches on drier ground.
ground ground/litter
tile 2.5
moisture 0 0.45 0.15
patch 45 0.45

# Grass in clearings on gentle, moderately moist ground.
ground ground/grass
tile 3
slope 0 18 6
moisture 0.3 0.85 0.15
patch 120 0.4

# Mud where water gathers: wet ground, the bottoms of drainage lines, a band along the shore.
ground ground/mud
tile 3
moisture 0.82 1 0.1
water_depth 0 0.05 0.05
strength 1.2

# Sand and gravel on the shore line and in shallow water.
ground ground/sand
tile 2.5
water_distance 0 2 2
water_depth 0 0.5 0.4
strength 1.6

# Small stones on the lake bed and in stream beds.
ground ground/stones
tile 2
water_depth 0.6 1000 0.4
strength 2

# Rock on steep ground.
ground ground/rock
tile 6
slope 32 90 8
strength 2

# Things put by hand, in meters on the map: a few big boulders at the edge of the clearing
# above the lake.
object rocks/boulder 3538 5112 40 2.2
object rocks/boulder 3585 5121 160 1.8
object rocks/boulder 3572 5096 275 2.6

# --- Trees: one grid of 9 m for all of them, out to 1200 m from the start. Pines on drier
# ground, spruces and birches where it is wetter, oaks on gentle slopes; none on steep
# gully walls, in the water or right at the shore. Each kind has two trees (the second with
# _b), half the density each, growing in the same clumps. ---
plant trees/pine
group trees
spacing 9
density 0.00275
scale 0.8 1.2
slope 0 30 4
moisture 0 0.35 0.15
water_distance 10 1e9 6
water_depth 0 0 0.01
patch 350 0.75
area 1200

plant trees/pine_b
group trees
density 0.00275
scale 0.8 1.2
slope 0 30 4
moisture 0 0.35 0.15
water_distance 10 1e9 6
water_depth 0 0 0.01
patch 350 0.75
area 1200

plant trees/spruce
group trees
density 0.00175
scale 0.8 1.2
slope 0 30 4
moisture 0.25 1 0.1
water_distance 8 1e9 6
water_depth 0 0 0.01
patch 160 0.55
area 1200

plant trees/spruce_b
group trees
density 0.00175
scale 0.8 1.2
slope 0 30 4
moisture 0.25 1 0.1
water_distance 8 1e9 6
water_depth 0 0 0.01

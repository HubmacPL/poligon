poligon-level 1

# The level of forest_scene (format: docs/en/assets.md, plant rules: docs/en/vegetation.md).
# The land is the terrain generator's default; the lines below only name the settings that
# matter most.
terrain.seed 1
terrain.size 6000
terrain.relief 110
terrain.basin_count 3

# On a slope above the largest lake, looking at it.
player_start lake

# Things put by hand, in meters on the map: a few big boulders at the edge of the clearing
# above the lake.
object rocks/boulder 3538 5112 40 2.2
object rocks/boulder 3585 5121 160 1.8
object rocks/boulder 3572 5096 275 2.6

# --- Trees: one grid of 9 m for all four, out to 1200 m from the start. Pines on drier
# ground, spruces and birches where it is wetter, oaks on gentle slopes; none on steep
# gully walls, in the water or right at the shore. ---
plant trees/pine
group trees
spacing 9
density 0.0055
scale 0.8 1.2
slope 0 30 4
moisture 0 0.35 0.15
water_distance 10 1e9 6
water_depth 0 0 0.01
patch 350 0.75
area 1200

plant trees/spruce
group trees
density 0.0035
scale 0.8 1.2
slope 0 30 4
moisture 0.25 1 0.1
water_distance 8 1e9 6
water_depth 0 0 0.01
patch 160 0.55
area 1200

plant trees/birch
group trees
density 0.0025
scale 0.8 1.2
slope 0 28 4
moisture 0.2 0.8 0.1
water_distance 6 1e9 4
water_depth 0 0 0.01
patch 90 0.5
area 1200

plant trees/oak
group trees
density 0.002
scale 0.8 1.2
slope 0 18 4
moisture 0.1 0.5 0.1
water_distance 12 1e9 6
water_depth 0 0 0.01
patch 220 0.5
area 1200

# --- Undergrowth and dead wood near the start (within 250 m). ---
plant trees/spruce_young
group undergrowth
spacing 4
density 0.0016
scale 0.5 1.3
slope 0 30 4
moisture 0.2 1 0.1
water_depth 0 0 0.01
patch 60 0.5
area 250

plant trees/pine_young
group undergrowth
density 0.0014
scale 0.5 1.3
slope 0 30 4
moisture 0 0.4 0.15
water_depth 0 0 0.01
patch 60 0.5
area 250

plant plants/shrub
group undergrowth
density 0.0025
scale 0.7 1.2
slope 0 33 4
moisture 0.15 1 0.1
water_distance 3 1e9 2
water_depth 0 0 0.01
area 250

plant rocks/boulder
spacing 12
density 0.0006
scale 0.6 2.2
sink 0.25
slope 4 45 4
water_depth 0 0 0.01
area 250

plant wood/stump
spacing 10
density 0.0005
scale 0.8 1.2
sink 0.05
slope 0 25 4
water_depth 0 0 0.01
area 250

plant wood/fallen_trunk
spacing 14
density 0.0004
scale 0.9 1.4
sink 0.1
slope 0 15 3
water_depth 0 0 0.01
area 250

# --- Water and shore plants, made by the engine (poligon/procedural_plants.h), at every lake
# within 1500 m: reeds in shallow water and along the shore, cattails in shallow water,
# water lilies floating where it is deeper. ---
plant procedural/reed
group shore
spacing 1.6
density 0.32
scale 0.8 1.15
water_depth 0 0.5 0.15
water_distance 0 2.5 1.5
patch 30 0.6
area 1500

plant procedural/cattail
group shore
density 0.18
scale 0.85 1.15
water_depth 0.08 0.4 0.08
patch 18 0.45
area 1500

plant procedural/water_lily
spacing 2.2
density 0.14
scale 0.8 1.3
water_depth 0.7 2.5 0.3
on_water 1
patch 28 0.4
area 1500

# --- Ground cover: grows on the fly around the player. ---
cover plants/grass
density 3
scale 2.5 4
slope 0 40 3
water_depth 0 0 0.01
patch 20 0.8
align 1
every_nth 3

cover plants/fern
density 0.06
scale 0.9 1.7
slope 0 33 3
moisture 0.12 1 0.1
water_depth 0 0 0.01
patch 20 0.5

cover plants/nettle
density 0.03
scale 2.5 4
slope 0 33 3
moisture 0.35 1 0.1
water_distance 2 1e9 1
water_depth 0 0 0.01
patch 20 0.45

cover plants/low_shrub
density 0.02
scale 1.2 2
slope 0 33 3
water_depth 0 0 0.01
patch 20 0.6

cover rocks/mossy_rocks
density 0.002
scale 0.35 0.8
slope 0 50 3
sink 0.08
water_depth 0 0.3 0.2
align 1
